# ================================================================
# CLASSIFICATION - PARTIE 1 (K-means)
# ================================================================
library(FactoMineR)
library(factoextra)
library(cluster)
library(tidyverse)
# Charger les données
bank_num_scaled <- readRDS("data/bank_num_scaled.rds")
bank_data <- readRDS("data/bank_data_raw.rds")
# Exécuter K-means
set.seed(123)
res_kmeans <- kmeans(bank_num_scaled, centers = 4, nstart = 25, iter.max = 100)
# Sauvegarder le résultat
saveRDS(res_kmeans, "outputs/res_kmeans.rds")
cat("✅ res_kmeans.rds sauvegardé\n")
# Ajouter les clusters aux données
bank_data_clusters <- bank_data %>%
mutate(cluster = as.factor(res_kmeans$cluster))
# Sauvegarder
saveRDS(bank_data_clusters, "data/bank_data_with_clusters.rds")
cat("✅ bank_data_with_clusters.rds sauvegardé\n")
# Graphique des clusters
png("outputs/kmeans_clusters.png", width = 800, height = 600)
fviz_cluster(res_kmeans,
data = bank_num_scaled,
palette = c("#2E9FDF", "#00AFBB", "#E7B800", "#FC4E07"),
ellipse.type = "norm",
geom = "point")
dev.off()
cat("✅ kmeans_clusters.png sauvegardé\n")
# Afficher le résumé
print(table(res_kmeans$cluster))
# ================================================================
# CLASSIFICATION - PARTIE 2 (CAH)
# ================================================================
# Classification Hiérarchique
cat("🔄 Classification Hiérarchique...\n")
# Matrice de distance (peut prendre 1-2 minutes)
dist_matrix <- dist(bank_num_scaled, method = "euclidean")
# CAH
res_hc <- hclust(dist_matrix, method = "ward.D2")
# ================================================================
# FIN DU PROJET - SANS CAH
# ================================================================
library(FactoMineR)
library(factoextra)
library(tidyverse)
# 1. K-means déjà fait ? Vérifions
if(!file.exists("outputs/res_kmeans.rds")) {
cat("🔄 Exécution de K-means...\n")
bank_num_scaled <- readRDS("data/bank_num_scaled.rds")
bank_data <- readRDS("data/bank_data_raw.rds")
set.seed(123)
res_kmeans <- kmeans(bank_num_scaled, centers = 4, nstart = 25)
bank_data_clusters <- bank_data %>%
mutate(cluster = as.factor(res_kmeans$cluster))
saveRDS(res_kmeans, "outputs/res_kmeans.rds")
saveRDS(bank_data_clusters, "data/bank_data_with_clusters.rds")
# Graphique
png("outputs/kmeans_clusters.png", width = 800, height = 600)
fviz_cluster(res_kmeans, data = bank_num_scaled,
palette = c("#2E9FDF", "#00AFBB", "#E7B800", "#FC4E07"),
ellipse.type = "norm", geom = "point")
dev.off()
cat("✅ K-means terminé\n")
} else {

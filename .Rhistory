library(tidyverse)
library(FactoMineR)
library(factoextra)
library(cluster)
library(corrplot)
cat("==================================================\n")
cat("📊 RÉGÉNÉRATION COMPLÈTE DU PROJET\n")
cat("==================================================\n\n")
# 2. CHARGEMENT DES DONNÉES
cat("📂 Chargement des données...\n")
bank_data <- readRDS("data/bank_data_raw.rds")
bank_num_scaled <- readRDS("data/bank_num_scaled.rds")
target_y <- bank_data$y
# 3. ACP
cat("\n📊 Régénération de l'ACP...\n")
res_pca <- PCA(bank_num_scaled,
scale.unit = FALSE,
graph = FALSE)
# Sauvegarder
saveRDS(res_pca, "outputs/res_pca.rds")
cat("✅ res_pca.rds sauvegardé\n")

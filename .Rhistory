}
if(!file.exists("outputs/acp_cercle_correlations.png")) {
png("outputs/acp_cercle_correlations.png", width = 800, height = 700)
fviz_pca_var(res_pca,
col.var = "contrib",
gradient.cols = c("#00AFBB", "#E7B800", "#FC4E07"),
repel = TRUE)
dev.off()
cat("✅ acp_cercle_correlations.png\n")
}
if(!file.exists("outputs/acp_contrib_dim1.png")) {
png("outputs/acp_contrib_dim1.png", width = 800, height = 500)
fviz_contrib(res_pca, choice = "var", axes = 1, top = 10)
dev.off()
cat("✅ acp_contrib_dim1.png\n")
}
if(!file.exists("outputs/acp_contrib_dim2.png")) {
png("outputs/acp_contrib_dim2.png", width = 800, height = 500)
fviz_contrib(res_pca, choice = "var", axes = 2, top = 10)
dev.off()
cat("✅ acp_contrib_dim2.png\n")
}
if(!file.exists("outputs/acp_individus_y.png")) {
png("outputs/acp_individus_y.png", width = 800, height = 600)
fviz_pca_ind(res_pca,
col.ind = as.factor(target_y),
palette = c("red", "green"),
addEllipses = TRUE,
ellipse.level = 0.95,
repel = TRUE)
dev.off()
cat("✅ acp_individus_y.png\n")
}
# 4. K-MEANS
cat("\n📊 Régénération de K-means...\n")
set.seed(123)
res_kmeans <- kmeans(bank_num_scaled, centers = 4, nstart = 25, iter.max = 100)
# Sauvegarder
saveRDS(res_kmeans, "outputs/res_kmeans.rds")
cat("✅ res_kmeans.rds sauvegardé\n")
# Ajouter les clusters aux données
bank_data_clusters <- bank_data %>%
mutate(cluster = as.factor(res_kmeans$cluster))
saveRDS(bank_data_clusters, "data/bank_data_with_clusters.rds")
cat("✅ bank_data_with_clusters.rds sauvegardé\n")
# Graphiques K-means
if(!file.exists("outputs/kmeans_elbow.png")) {
png("outputs/kmeans_elbow.png", width = 800, height = 500)
fviz_nbclust(bank_num_scaled, kmeans, method = "wss", k.max = 10)
dev.off()
cat("✅ kmeans_elbow.png\n")
}
if(!file.exists("outputs/kmeans_silhouette.png")) {
png("outputs/kmeans_silhouette.png", width = 800, height = 500)
fviz_nbclust(bank_num_scaled, kmeans, method = "silhouette", k.max = 10)
dev.off()
cat("✅ kmeans_silhouette.png\n")
}
if(!file.exists("outputs/kmeans_clusters.png")) {
png("outputs/kmeans_clusters.png", width = 800, height = 600)
fviz_cluster(res_kmeans,
data = bank_num_scaled,
palette = c("#2E9FDF", "#00AFBB", "#E7B800", "#FC4E07"),
ellipse.type = "norm",
geom = "point")
dev.off()
cat("✅ kmeans_clusters.png\n")
}
# 5. ANALYSE COMBINÉE
cat("\n🔗 Analyse combinée...\n")
# Clusters sur ACP
if(!file.exists("outputs/combi_clusters_acp.png")) {
png("outputs/combi_clusters_acp.png", width = 800, height = 600)
fviz_pca_ind(res_pca,
col.ind = bank_data_clusters$cluster,
palette = c("#2E9FDF", "#00AFBB", "#E7B800", "#FC4E07"),
addEllipses = TRUE,
ellipse.level = 0.95,
repel = TRUE)
dev.off()
cat("✅ combi_clusters_acp.png\n")
}
# Heatmap
if(!file.exists("outputs/combi_heatmap.png")) {
vars_cles <- c("age", "duration", "campaign", "pdays", "euribor3m")
profile_num <- bank_data_clusters %>%
group_by(cluster) %>%
summarise(across(all_of(vars_cles), mean, .names = "mean_{.col}"))
profile_long <- profile_num %>%
pivot_longer(cols = starts_with("mean_"),
names_to = "variable",
values_to = "value") %>%
mutate(variable = str_remove(variable, "mean_"))
png("outputs/combi_heatmap.png", width = 800, height = 500)
ggplot(profile_long, aes(x = cluster, y = variable, fill = value)) +
geom_tile() +
scale_fill_gradient2(low = "red", mid = "white", high = "green") +
labs(x = "Cluster", y = "Variable", fill = "Valeur") +
theme_minimal()
dev.off()
cat("✅ combi_heatmap.png\n")
}
# Taux de souscription
if(!file.exists("outputs/combi_taux_souscription.png")) {
cluster_target <- bank_data_clusters %>%
group_by(cluster, y) %>%
summarise(n = n(), .groups = "drop") %>%
group_by(cluster) %>%
mutate(pct = n / sum(n) * 100) %>%
filter(y == "yes")
png("outputs/combi_taux_souscription.png", width = 600, height = 500)
ggplot(cluster_target, aes(x = cluster, y = pct, fill = cluster)) +
geom_col() +
geom_text(aes(label = paste0(round(pct, 1), "%")), vjust = -0.5, size = 6) +
labs(x = "Cluster", y = "Taux de souscription (%)") +
theme_minimal() +
theme(legend.position = "none")
dev.off()
cat("✅ combi_taux_souscription.png\n")
}
# 6. PROFILS DES CLUSTERS
cat("\n============================================================\n")
cat("📋 PROFILS DES CLUSTERS\n")
cat("============================================================\n\n")
# Résumé par cluster
cluster_summary <- bank_data_clusters %>%
group_by(cluster) %>%
summarise(
Taille = n(),
`%` = round(n() / nrow(bank_data) * 100, 1),
`Âge moyen` = round(mean(age), 1),
`Durée d'appel` = round(mean(duration), 1),
`Taux souscription` = round(mean(y == "yes") * 100, 1)
)
print(cluster_summary)
cat("\n\n📋 DÉTAIL DES CLUSTERS :\n\n")
for(i in 1:4) {
cat("🏷️  CLUSTER", i, "\n")
cat("------------------------------\n")
data_cluster <- bank_data_clusters %>% filter(cluster == i)
cat("  • Taille :", nrow(data_cluster),
"clients (", round(nrow(data_cluster)/nrow(bank_data)*100, 1), "%)\n")
cat("  • Âge moyen :", round(mean(data_cluster$age), 1), "ans\n")
cat("  • Durée d'appel :", round(mean(data_cluster$duration), 1), "s\n")
cat("  • Nombre de contacts :", round(mean(data_cluster$campaign), 1), "\n")
cat("  • Taux souscription :",
round(mean(data_cluster$y == "yes") * 100, 1), "%\n")
top_job <- names(sort(table(data_cluster$job), decreasing = TRUE))[1]
cat("  • Métier principal :", top_job, "\n")
top_edu <- names(sort(table(data_cluster$education), decreasing = TRUE))[1]
cat("  • Éducation principale :", top_edu, "\n")
cat("\n")
}
# 7. VÉRIFICATION FINALE
cat("\n============================================================\n")
cat("📁 FICHIERS DANS outputs/ :\n")
cat("============================================================\n")
print(list.files("outputs/"))
cat("\n📊 Nombre total de fichiers :", length(list.files("outputs/")), "\n")
# Vérifier les fichiers importants
fichiers_importants <- c(
"res_pca.rds", "res_kmeans.rds", "bank_data_with_clusters.rds",
"acp_variance.png", "kmeans_clusters.png", "combi_clusters_acp.png"
)
cat("\n✅ Vérification des fichiers importants :\n")
for(f in fichiers_importants) {
existe <- file.exists(paste0("outputs/", f)) | file.exists(paste0("data/", f))
if(existe) {
cat("  ✅", f, "\n")
} else {
cat("  ❌", f, "MANQUANT\n")
}
}
cat("\n🎉 PROJET TERMINÉ !\n")
cat("📌 Note : La CAH n'a pas été exécutée car trop gourmande en mémoire.\n")
cat("   K-means est la méthode de classification principale.\n")
list.files("outputs/")
# ================================================================
# 03_bis_acm.R
# Analyse des Correspondances Multiples (ACM)
# Projet Bank Marketing - Analyse Multivariée
# ================================================================
# 1. CHARGEMENT ==================================================
library(FactoMineR)
library(factoextra)
library(tidyverse)
cat("📊 Analyse des Correspondances Multiples (ACM)...\n")
# 2. CHARGER LES DONNÉES ========================================
bank_data <- readRDS("data/bank_data_raw.rds")
# 3. SÉLECTION DES VARIABLES CATÉGORIELLES ======================
# On sélectionne les variables catégorielles pertinentes
# On exclut 'y' (variable cible) pour une analyse non supervisée
cat_vars <- c("job", "marital", "education", "default",
"housing", "loan", "contact", "month",
"day_of_week", "poutcome")
# Créer le dataframe pour l'ACM
bank_cat <- bank_data %>%
select(all_of(cat_vars))
cat("\n📋 Variables sélectionnées pour l'ACM :\n")
print(names(bank_cat))
cat("\n📊 Dimensions du jeu de données ACM :", dim(bank_cat), "\n")
# 4. RÉALISATION DE L'ACM ========================================
cat("\n🔄 Réalisation de l'ACM...\n")
res_mca <- MCA(bank_cat,
graph = FALSE,
ncp = 5)  # Nombre de dimensions à conserver
# 5. RÉSULTATS ==================================================
cat("\n📈 Valeurs propres et variance expliquée :\n")
eigenvalues_mca <- get_eigenvalue(res_mca)
print(eigenvalues_mca)
# 6. SAUVEGARDE =================================================
saveRDS(res_mca, "outputs/res_mca.rds")
cat("✅ res_mca.rds sauvegardé\n")
# 7. GRAPHIQUES =================================================
cat("\n💾 Sauvegarde des graphiques...\n")
# Variance expliquée
png("outputs/acm_variance.png", width = 800, height = 500)
fviz_eig(res_mca, addlabels = TRUE,
barfill = "darkgreen", barcolor = "darkgreen",
title = "Variance expliquée par l'ACM")
dev.off()
cat("✅ acm_variance.png\n")
# Graphique des variables (modalités)
png("outputs/acm_variables.png", width = 900, height = 700)
fviz_mca_var(res_mca,
col.var = "contrib",
gradient.cols = c("#00AFBB", "#E7B800", "#FC4E07"),
repel = TRUE,
title = "Projection des modalités - ACM")
dev.off()
cat("✅ acm_variables.png\n")
# Graphique des individus
png("outputs/acm_individus.png", width = 800, height = 600)
fviz_mca_ind(res_mca,
col.ind = "cos2",
gradient.cols = c("#00AFBB", "#E7B800", "#FC4E07"),
repel = TRUE,
title = "Projection des individus - ACM")
dev.off()
cat("✅ acm_individus.png\n")
# Individus colorés par souscription
png("outputs/acm_individus_y.png", width = 800, height = 600)
fviz_mca_ind(res_mca,
col.ind = as.factor(bank_data$y),
palette = c("red", "green"),
addEllipses = TRUE,
ellipse.level = 0.95,
repel = TRUE,
title = "ACM - Individus par souscription")
dev.off()
cat("✅ acm_individus_y.png\n")
# Biplot (variables + individus)
png("outputs/acm_biplot.png", width = 900, height = 700)
fviz_mca_biplot(res_mca,
repel = TRUE,
title = "Biplot - ACM")
dev.off()
cat("✅ acm_biplot.png\n")
# 8. CONTRIBUTIONS DES VARIABLES ================================
cat("\n📊 Contributions des variables aux dimensions :\n")
# Contributions à la dimension 1
contrib_dim1 <- res_mca$var$contrib %>%
as.data.frame() %>%
rownames_to_column("variable") %>%
arrange(desc(Dim.1)) %>%
head(10)
file.rename("rapport/Méthodes-statistiques-et-étude-de-données.Rmd",
"rapport/rapport_projet.Rmd")

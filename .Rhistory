print(fviz_contrib(res_pca, choice = "var", axes = 1, top = 10))
dev.off()
png("outputs/acp_contrib_dim2.png", width = 800, height = 500)
print(fviz_contrib(res_pca, choice = "var", axes = 2, top = 10))
dev.off()
png("outputs/acp_individus_y.png", width = 800, height = 600)
print(fviz_pca_ind(res_pca,
col.ind = as.factor(target_y),
palette = c("red", "green"),
addEllipses = TRUE,
ellipse.level = 0.95,
repel = TRUE,
title = "ACP - Individus par souscription"))
list.files("outputs/")
